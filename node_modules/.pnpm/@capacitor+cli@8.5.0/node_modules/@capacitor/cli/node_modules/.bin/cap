#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/deck/VideoQualityCheckerApp/node_modules/.pnpm/@capacitor+cli@8.5.0/node_modules/@capacitor/cli/bin/node_modules:/home/deck/VideoQualityCheckerApp/node_modules/.pnpm/@capacitor+cli@8.5.0/node_modules/@capacitor/cli/node_modules:/home/deck/VideoQualityCheckerApp/node_modules/.pnpm/@capacitor+cli@8.5.0/node_modules/@capacitor/node_modules:/home/deck/VideoQualityCheckerApp/node_modules/.pnpm/@capacitor+cli@8.5.0/node_modules:/home/deck/VideoQualityCheckerApp/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/deck/VideoQualityCheckerApp/node_modules/.pnpm/@capacitor+cli@8.5.0/node_modules/@capacitor/cli/bin/node_modules:/home/deck/VideoQualityCheckerApp/node_modules/.pnpm/@capacitor+cli@8.5.0/node_modules/@capacitor/cli/node_modules:/home/deck/VideoQualityCheckerApp/node_modules/.pnpm/@capacitor+cli@8.5.0/node_modules/@capacitor/node_modules:/home/deck/VideoQualityCheckerApp/node_modules/.pnpm/@capacitor+cli@8.5.0/node_modules:/home/deck/VideoQualityCheckerApp/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../bin/capacitor" "$@"
else
  exec node  "$basedir/../../bin/capacitor" "$@"
fi
